[Unit]
Description=Chrome on :99 with CDP 9222 (for Playwright MCP / noVNC)
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:99
Environment=LANG=zh_TW.UTF-8
Environment=LC_ALL=zh_TW.UTF-8
Environment=LANGUAGE=zh_TW:zh
# 若沒有要載入擴充套件，把下面兩行與 ExecStart 內的 --load-extension/--disable-extensions-except 移除
ExecStart=/opt/chrome-linux64/chrome --no-sandbox --disable-gpu --disable-dev-shm-usage --no-first-run --no-default-browser-check --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 --user-data-dir=/root/chrome-profile --window-size=1600,900 --window-position=0,0 --lang=zh-TW --load-extension=/root/ext/autodl-v2,/root/ext/dsh-browser-control --disable-extensions-except=/root/ext/autodl-v2,/root/ext/dsh-browser-control
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
